
@article{aljubran_techno-economics_2025,
	title = {Techno-economics of geothermal power in the contiguous {United} {States} under baseload and flexible operations},
	volume = {211},
	issn = {1364-0321},
	url = {https://www.sciencedirect.com/science/article/pii/S1364032124010487},
	doi = {10.1016/j.rser.2024.115322},
	abstract = {As geothermal technology continues to gain momentum, it becomes increasingly important for stakeholders to assess the economic feasibility of geothermal power projects when integrated into electricity markets. This study evaluated the techno-economic viability of identified and undiscovered hydrothermal systems across the contiguous United States. Multiple data and methods were developed and integrated to model the lifecycle techno-economics of geothermal projects at hourly resolution. Additionally, flexible operations through wellhead throttling were evaluated to estimate the potential improvement compared to business-as-usual power plant operations. A total of 3,632 and 17,789 MWe of identified and undiscovered hydrothermal resources, respectively, were found to be economically competitive. Multiple sites were profitable under a typical 70 USD/MWh power purchase agreement, with return on investment up to 800\%. Meanwhile, operating under the open power market yielded a mix of profitable and non-profitable projects across sites. Opting for flexible dispatch resulted in an improved economic performance. In particular, the most profitable site had nearly 10\% relative improvement in return on investment upon switching from baseload to flexible dispatch.},
	urldate = {2026-06-01},
	journal = {Renewable and Sustainable Energy Reviews},
	author = {Aljubran, Mohammad J. and Horne, Roland N.},
	month = apr,
	year = {2025},
	keywords = {Power markets, Flexible, Geothermal, Techno-economic, United States},
	pages = {115322},
	file = {ScienceDirect Full Text PDF:/Users/david/Zotero/storage/UF9GBJIM/Aljubran and Horne - 2025 - Techno-economics of geothermal power in the contiguous United States under baseload and flexible ope.pdf:application/pdf;ScienceDirect Snapshot:/Users/david/Zotero/storage/KUZ3LBN3/S1364032124010487.html:text/html},
}

@misc{aljubran_techno-economics_2024,
	title = {Techno-economics of {Geothermal} {Power} in the {Contiguous} {United} {States} {Under} {Baseload} and {Flexible} {Operations} ({Dataset})},
	url = {https://zenodo.org/records/12561790},
	doi = {10.5281/zenodo.12561790},
	abstract = {This dataset was created as part of a project that is undergoing journal peer-review. Here is the abstract:

 

As geothermal technology continues to gain momentum, it becomes increasingly essential for stakeholders to assess the economic feasibility of geothermal power projects when integrated into electricity markets. This study aimed to evaluate the techno-economic viability of identified and undiscovered hydrothermal systems across the contiguous United States. Multiple data and methods were developed and integrated to model the lifecycle techno-economics of geothermal projects at hourly resolution. Additionally, flexible operations through wellhead throttling were evaluated to estimate the potential improvement compared to business-as-usual power plant operations. A total of 3,632 and 17,789 MWe of identified and undiscovered hydrothermal resources, respectively, were found to be economically competitive. Multiple sites were profitable under a typical 70 USD/MWh power purchase agreement, with return on investment close to 400\%. However, operating in the open power market yielded non-profitable projects across the majority of sites. Opting for flexible dispatch resulted in an improved economic performance. Particularly, the most profitable site had nearly 20{\textbackslash}\% relative improvement in return on investment upon switching from baseload to flexible dispatch.},
	urldate = {2026-06-01},
	publisher = {Zenodo},
	author = {Aljubran, Mohammad and Horne, Roland},
	month = jun,
	year = {2024},
	file = {Snapshot:/Users/david/Zotero/storage/3BPAM4T8/12561790.html:text/html},
}

@article{akindipe_2025_nodate,
	title = {2025 {Geothermal} {Drilling} {Cost} {Curves} {Update}},
	abstract = {Drilling activities account for 30\% to 57\% of the cost to develop and install a geothermal plant. Therefore, an accurate representation of the cost to drill a well is paramount in techno-economic analysis to determine the feasibility of a geothermal power project. In 2022, the National Renewable Energy Laboratory endeavored to revise the U.S. Department of Energy GeoVision baseline drilling cost curves due to extensive improvement in drilling rates at the Utah Frontier Observatory Research in Geothermal Energy (FORGE) demonstration site. That effort did not culminate in the recommendation of new curves, because the actual project costs did not match the reported performance improvements and were at or above the GeoVision baseline. The need for another iteration of this analysis has arisen from industry record drilling performance reported by recent commercial field-scale and demonstration projects, including Fervo Energy’s Cape Station, the Utah FORGE 16B(78)-32 demonstration, and Geysers Power Company’s GDC-36 demonstration. Therefore, in this work, we have estimated the resulting industry average rate of penetration and bit life and applied these parameters as inputs to the Well Cost Simplified model used in the GeoVision analysis. The revised cost curves show a significant decline compared to the GeoVision baseline. For vertical wells, the magnitude of cost reduction ranges from 12\% to 24\%, while for horizontal wells, the estimated cost reduction is between 18\% and 26\%. These revised cost curves align well with actual commercial drilling cost data, and therefore, quantify the economic impact of the utilization of (and advances in) polycrystalline diamond compact bit technology and the application of physics-based methodologies that optimize mechanical specific energy.},
	language = {en},
	author = {Akindipe, Dayo and Witter, Erik},
	file = {PDF:/Users/david/Zotero/storage/DBKHMA3T/Akindipe and Witter - 2025 Geothermal Drilling Cost Curves Update.pdf:application/pdf},
}

